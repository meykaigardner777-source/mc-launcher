{
  "name": "aetheria-launcher",
  "version": "1.0.0",
  "description": "Native Windows on ARM64 Minecraft Desktop Launcher",
  "author": "YourName",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:arm": "electron-builder --win --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "30.0.6",
    "electron-builder": "24.13.3"
  },
  "build": {
    "publish": null,
    "appId": "com.aetheria.launcher",
    "productName": "Aetheria Launcher",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
