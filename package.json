{
  "name": "aetheria-launcher",
  "version": "1.2.1",
  "description": "Monochrome ARM64 Native Minecraft Desktop Launcher",
  "author": "Aetheria",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mods": "cd mod && gradlew.bat buildAllMods",
    "pack:arm": "electron-builder --win --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "30.0.6",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.aetheria.launcher",
    "productName": "Aetheria Launcher",
    "asarUnpack": [
      "extensions/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
