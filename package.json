{
  "name": "aetheria-launcher",
  "version": "1.0.0",
  "description": "Native ARM64 Minecraft Desktop Launcher",
  "author": "YourName",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:arm": "electron-builder --win --arm64"
  },
  "devDependencies": {
    "electron": "30.0.6",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.aetheria.launcher",
    "productName": "Aetheria Launcher",
    "win": {
      "target": "portable"
    }
  }
}
